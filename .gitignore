# Local logs, if any dev server writes them
*.log

# Real/test screenshots dropped into the sample watch folder during local
# testing — this folder should ship with just the placeholder README so
# the repo stays small and doesn't leak anyone's actual screen captures.
screenshots/*
!screenshots/README.txt

